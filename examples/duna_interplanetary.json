{
  "name": "MCP Duna Interplanetary Expedition",
  "description": "A stock KSP 1.12.x four-stage reference vehicle for a Kerbin launch, orbital insertion, Duna transfer, and powered terminal descent. It uses an explicit probe core, no-vision MCP staging, and four engines per chemical booster stage.",
  "editor_mode": "VAB",
  "mission": {
    "destination": "Duna",
    "architecture": "four-engine core launch stage -> four-engine orbital insertion stage -> nuclear transfer stage -> powered terminal descent stage",
    "staging_order": [
      "stage 3: four Mainsails, four Size3 tanks, and the core engine mount",
      "stage 2: separate the core, then use four orbital Mainsails and two Jumbo tanks",
      "stage 1: separate the chemical insertion stage, then use the nuclear transfer engine",
      "stage 0: separate the transfer stack, then use the Poodle descent engine"
    ],
    "required_runtime_checks": [
      "ksp_parts_list",
      "ksp_editor_validate",
      "ksp_editor_analyze",
      "ksp_editor_save",
      "ksp_editor_launch",
      "ksp_flight_guidance_start",
      "ksp_realtime_state"
    ],
    "design_invariants": [
      "The probe core is a real controllable command source and is included even when the crew pod is present.",
      "All four engines of each chemical stage are attached when the craft is first built; no engine is removed and replaced later.",
      "The immediate post-launch stage must have useful vacuum thrust, so the nuclear transfer stage is not used as the first upper stage.",
      "The MCP must wait for editor build events and validate the live KSP tree before launch."
    ]
  },
